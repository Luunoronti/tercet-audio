  (text "Rozladowanie: przy zaniku sieci K1 zwalnia, styk NC (11-12) laczy +300V z R306" (at 218.44 346.71 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid c9cbda82-ffcf-5b07-9d49-1e1268dd7f57))
  (text "-> B+ <50V w ok. 15 s. K1: cewka 9V (V_RAW), styki min. 250V. Bleeder R303 = wolna 2. linia." (at 218.44 349.25 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid 9d97b0fb-8ed4-5fc9-ac6d-807b361c0394))
  (text "Zarzenie: 6,3V DC / ok. 1,7A (2x EL84 0,76A + ECC82 0,15A; budzet 1,9A) z uzwojenia 7V/3A." (at 218.44 370.84 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid c1dd5900-e036-583e-922c-e3773c79a879))
